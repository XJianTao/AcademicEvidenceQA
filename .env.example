POSTGRES_USER=academic
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=academic_evidence
POSTGRES_PORT=55432
# 可选 DATABASE_URL 使用 postgresql+psycopg，由私有 .env/当前进程提供。
# DATABASE_URL=
DATA_ROOT=data
PDF_MAX_UPLOAD_BYTES=104857600
PDF_MAX_PAGES=300
PDF_PREFLIGHT_TIMEOUT_SECONDS=30
PDF_PREFLIGHT_MEMORY_MIB=512
LOCAL_PARSE_TIMEOUT_SECONDS=900
LOCAL_PARSE_MEMORY_MIB=8192
LOCAL_PARSER_CONCURRENCY=1
PARSER_QUEUE_CAPACITY=2
MINERU_JOB_TIMEOUT_SECONDS=1800
MINERU_MAX_RETRIES=2
REMOTE_CONNECT_TIMEOUT_SECONDS=10
REMOTE_READ_TIMEOUT_SECONDS=60
RESULT_MAX_DOWNLOAD_BYTES=536870912
RESULT_MAX_EXTRACTED_BYTES=2147483648
RESULT_MAX_FILES=10000
RESULT_MAX_JSON_BYTES=134217728
RESULT_EXTRACT_TIMEOUT_SECONDS=120
RESULT_EXTRACT_MEMORY_MIB=1024
NORMALIZATION_TIMEOUT_SECONDS=120
NORMALIZATION_MEMORY_MIB=2048
# 仅在运行真实集成测试时设置；固定前缀，自动创建专用空库，不删除库。
# M1A_TEST_DATABASE=aeqa_m1a_test_20261012
QDRANT_HTTP_PORT=56333
QDRANT_GRPC_PORT=56334
QDRANT_URL=http://127.0.0.1:56333
# API 必须先启动；生产 Worker 仅通过 loopback 复用其模型，不加载权重或回退。
MODEL_API_URL=http://127.0.0.1:8000
INFERENCE_QUEUE_CAPACITY=4

# Local-only model paths; no credentials belong in this file.
BGE_M3_MODEL_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
RERANKER_MODEL_PATH=D:/ai_models/modelscope_cache/models/rerank/BAAI/bge-reranker-large

# Set only in the current shell or a private local .env after confirming endpoint access.
# MINERU_API_TOKEN=
# MINERU_BASE_URL=
# MINERU_MODEL_VERSION=vlm
